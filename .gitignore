node_modules/
dist/
.wrangler/
.dev.vars
.env
.env.local
*.log
.DS_Store

# Local pipeline: secrets, build output and run logs stay on the machine.
# Every local env file, not just the default one. local/.env alone left
# local/.env.production untracked but not ignored, which is one git add -A
# away from committing a live admin token.
local/.env
local/.env.*
!local/.env.example
local/dist/
local/logs/
local/run-pipeline.cmd

# scratch output from test and pipeline runs
.tmp-*

# extraction pipeline: virtualenv, fetched bodies and run output
extract/.venv/
extract/.cache/
extract/out/
extract/**/__pycache__/
extract/.pytest_cache/.manual-verification/
.q.sql
.qout.txt
.audit-*.txt
.audit-frontend/
