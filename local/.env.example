# Tereflow local pipeline configuration.
#
# Copy to local/.env and fill in. That file is gitignored.

# Where to publish. Leave as localhost while developing.
TEREFLOW_API_URL=http://127.0.0.1:8787

# Must match the ADMIN_TOKEN secret on the Worker.
TEREFLOW_ADMIN_TOKEN=local-dev-token

# Optional but strongly recommended. Free from
# https://comtradedeveloper.un.org/
# Without it the preview endpoint allows one year per call, so a country costs
# about 23 requests instead of 9 and only three years of product detail are
# pulled.
# COMTRADE_API_KEY=

# How many years back to request. Trade statistics lag one to two years.
TEREFLOW_YEARS_BACK=6

# Pause between countries, in milliseconds. Keeps the public APIs happy.
TEREFLOW_POLITENESS_MS=1200
