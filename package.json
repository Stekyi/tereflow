{
  "name": "tereflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Global trade intelligence and business network",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "db:create": "wrangler d1 create tereflow",
    "db:migrate:local": "wrangler d1 migrations apply tereflow --local",
    "db:migrate": "wrangler d1 migrations apply tereflow --remote",
    "seed:build": "node scripts/build-seed.mjs",
    "hs:build": "node scripts/build-hs-labels.mjs",
    "seed:local": "wrangler d1 execute tereflow --local --file=./data/seed.sql",
    "seed:remote": "wrangler d1 execute tereflow --remote --file=./data/seed.sql",
    "data:export": "node scripts/export-data.mjs",
    "data:restore": "node scripts/restore-data.mjs",
    "data:restore:remote": "node scripts/restore-data.mjs --remote",
    "pipeline:build": "node local/build.mjs",
    "pipeline": "node local/build.mjs && node local/dist/pipeline.mjs",
    "pipeline:dry": "node local/build.mjs && node local/dist/pipeline.mjs --dry-run",
    "data:templates": "node local/build.mjs && node local/dist/manual-data.mjs templates",
    "data:validate": "node local/build.mjs && node local/dist/manual-data.mjs validate",
    "data:import": "node local/build.mjs && node local/dist/manual-data.mjs import",
    "data:analyse": "node local/build.mjs && node local/dist/manual-data.mjs analyse",
    "report:country": "node local/build.mjs && node local/dist/manual-data.mjs report",
    "test:reset": "node scripts/reset-ratelimit.mjs",
    "test:e2e": "node scripts/test-csv.mjs && node scripts/test-xlsx.mjs && node scripts/test-analyse.mjs && npm run test:reset && node scripts/e2e-network.mjs && node scripts/e2e-premium.mjs && node scripts/e2e-products.mjs && node scripts/e2e-portal.mjs && node scripts/e2e-insight.mjs",
    "test:csv": "node scripts/test-csv.mjs",
    "test:xlsx": "node scripts/test-xlsx.mjs",
    "test:analyse": "node scripts/test-analyse.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "^4.6.14",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
