# Oracle connection. Copy this file to .env and fill it in. Never share .env or the wallet.
ORACLE_WALLET_PATH=./Wallet_tereflow
ORACLE_WALLET_PASSWORD=
ORACLE_TNS_NAME=tereflow_high
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=

# Only needed for "pipeline.cmd load-inbox" (reads the admin upload queue from Cloudflare R2)
S3_API_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tereflow-media

# Only needed for "pipeline.cmd comtrade"
COMTRADE_API_KEY=
